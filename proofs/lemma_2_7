# Proof of Lemma 2.7
This notebook contains the computer-assisted part of the proof of Lemma 2.7.
"""

# ╔═╡ 755359f0-227d-496f-b1bc-851e3579e149
md"""
Let $g(w) = J_0(w\sqrt{\lambda})$, we want to prove that

$$|g'''(w)| \leq 6.1.$$

Note that

$$g'''(w) = -\frac{1}{4}\lambda^{3/2}\left(3J_1(w\sqrt{\lambda}) - J_3(w\sqrt{\lambda})\right).$$
"""

# ╔═╡ f756cd4a-a496-4366-b47b-71f14532431b
λ = SRP.λ_disc()

# ╔═╡ 26942198-2078-4d35-8444-f63d6e9e94aa
gd3(w) = λ^(3 // 2) * (3besselj1(w * sqrt(λ) - besselj(Arb(3), w * sqrt(λ)))) / 4

# ╔═╡ 0f8598e3-cf9d-4542-8145-3aa149211879
md"""
## Plots
"""

# ╔═╡ c1cf75a7-2e6d-43a4-8715-009c872be9ef
let
	fig = Figure()
	ax = Axis(
		fig[1, 1],
		xlabel = L"w",
	)
	lines!(ax, range(0, 20, 1000), gd3 ∘ Arb, label = L"g'''(w)")
	lines!(ax, range(0, 20, 1000), w -> 0.7858 * λ^(3 // 2 - 1 // 6) * w^(-1 // 3), label = L"0.7858\lambda^{1/6}w^{-1/3}")
	hlines!(ax, [-6.1, 6.1])
	axislegend(ax)
	fig
end

